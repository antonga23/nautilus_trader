User=root
EnvironmentFile=-/etc/cloudbet/self-hosted-runner.conf
EnvironmentFile=-/etc/cloudbet/actions-runner-hygiene.conf
ExecStart=/usr/local/bin/cloudbet-self-hosted-runner-cleanup
