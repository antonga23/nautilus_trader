[Unit]
Description=Cloudbet self-hosted runner hygiene cleanup
After=network.target docker.service

[Service]
Type=oneshot
User=root
EnvironmentFile=-/etc/cloudbet/self-hosted-runner.conf
EnvironmentFile=-/etc/cloudbet/actions-runner-hygiene.conf
WorkingDirectory=/opt/cloudbet-runner-hygiene
ExecStart=/opt/cloudbet-runner-hygiene/self_hosted_runner_cleanup.sh
